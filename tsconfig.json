{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  // vite.config.ts usa node:fs y node:crypto; Vite lo comprueba al cargarlo (sin @types/node, que sería una dependencia nueva).
  "include": ["src"]
}
